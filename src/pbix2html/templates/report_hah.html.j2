  document.querySelectorAll('[data-param]').forEach(i => i.addEventListener('change', reloadVisible));
  function showPage(id) {
    document.querySelectorAll('nav.tabs button').forEach(x => x.setAttribute('aria-selected', x.dataset.page === id));
    document.querySelectorAll('.page').forEach(p => { p.hidden = p.id !== id; });
    Object.values(charts).forEach(c => c.resize());
    fitAll();
    loadPage(id);
  }
  document.querySelectorAll('nav.tabs button').forEach(b => b.addEventListener('click', () => showPage(b.dataset.page)));
  document.querySelectorAll('[data-nav]').forEach(b => {
    b.addEventListener('click', () => showPage(b.dataset.nav));
    b.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); showPage(b.dataset.nav); } });
  });
  // Bookmark buttons: each page keeps the set of hidden groups; a visual is shown unless one
  // of its ancestor groups is in that set (ADR-005).
  const hiddenGroups = new Map();
  document.querySelectorAll('.page').forEach(pg => hiddenGroups.set(pg.id, new Set(JSON.parse(pg.dataset.hiddenGroups || '[]'))));
  function applyGroups(page) {
    const hs = hiddenGroups.get(page.id);
    page.querySelectorAll('[data-groups]').forEach(el => { el.hidden = el.dataset.groups.split(' ').some(g => hs.has(g)); });
    Object.values(charts).forEach(c => c.resize());
  }
  document.querySelectorAll('[data-set]').forEach(b => {
    const activate = () => {
      const page = b.closest('.page'), hs = hiddenGroups.get(page.id);
      Object.entries(JSON.parse(b.dataset.set)).forEach(([g, hidden]) => hidden ? hs.add(g) : hs.delete(g));
      applyGroups(page);
    };
    b.addEventListener('click', activate);
    b.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(); } });
  });
  window.addEventListener('resize', () => { Object.values(charts).forEach(c => c.resize()); fitAll(); });

  // HAH's snapshot-capture pass needs every tab's data present in one shot, not just
  // whichever page is visible on load — see ADR-004 / pbix2html-fixv1.md #10.
  if (window.__SNAPSHOT_CAPTURE__) { loadAll(); } else { loadPage(spec.pages[0] && spec.pages[0].id); }
})();
</script>
</body>
</html>
