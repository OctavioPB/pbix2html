<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ spec.report }}</title>
<script src="{{ echarts_cdn }}"></script>
<style>
  :root {
    --bg: {{ theme.background }};
    --fg: {{ theme.foreground }};
    --muted: {{ theme.muted }};
    --border: {{ theme.border }};
    --accent: {{ theme.data_colors[0] }};
    --font: {{ theme.font_family|safe }};
  }
  * { box-sizing: border-box; }
  button, input, select, textarea { font-family: inherit; }
  html, body { margin: 0; background: var(--bg); color: var(--fg); font-family: var(--font); font-size: 14px; }
  header { display: flex; align-items: baseline; gap: 1.5rem; padding: .75rem 1.25rem; border-bottom: 1px solid var(--border); }
  header h1 { font-size: 1.1rem; font-weight: 600; margin: 0; }
  header .meta { color: var(--muted); font-size: .8rem; }
  nav.tabs { display: flex; gap: .25rem; padding: .5rem 1.25rem 0; }
  nav.tabs button { background: none; border: 0; border-bottom: 2px solid transparent; padding: .4rem .6rem; cursor: pointer; color: var(--muted); font: inherit; }
  nav.tabs button[aria-selected="true"] { color: var(--fg); border-bottom-color: var(--accent); }
  .params { display: flex; flex-wrap: wrap; gap: .75rem 1.5rem; padding: .5rem 1.25rem; font-size: .85rem; color: var(--muted); }
  .params label { display: inline-flex; gap: .4rem; align-items: center; }
  .params input, .params select { font: inherit; padding: .15rem .3rem; }
  .page { position: relative; width: 100%; aspect-ratio: var(--ratio); margin: .5rem auto 2rem; max-width: 1400px; }
  .page[hidden] { display: none; }
  .visual { position: absolute; overflow: hidden; background: var(--bg); border: 1px solid var(--border); border-radius: 2px; display: flex; flex-direction: column; container-type: size; }
  .visual .title { font-size: clamp(.65rem, 8cqmin, .9rem); font-weight: 400; padding: .35rem .6rem 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .visual .title.wrap { white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; line-height: 1.15; }
  .visual .subtitle { font-size: .72rem; color: var(--muted); padding: 0 .6rem .1rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .visual .shape-text { display: flex; align-items: center; justify-content: center; height: 100%; text-align: center; font-size: .8rem; padding: .3rem; }
  .visual .body { flex: 1; min-height: 0; position: relative; }
  .chart { position: absolute; inset: 0; }
  .card { display: flex; flex-direction: column; justify-content: center; align-items: center; height: 100%; padding: .5rem; }
  .card .value { font-size: clamp(1rem, 20cqmin, 2.4rem); font-weight: 600; line-height: 1.1; max-width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .card .label { color: var(--muted); font-size: clamp(.6rem, 7cqmin, .8rem); margin-top: .3rem; max-width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .kpi .target { color: var(--muted); font-size: clamp(.6rem, 6cqmin, .8rem); max-width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .multicard { display: grid; grid-template-columns: 1fr auto; gap: .2rem .8rem; padding: .5rem .6rem; font-size: .85rem; align-content: start; }
  .multicard .v { text-align: right; font-weight: 600; }
  .tablewrap { overflow: auto; height: 100%; }
  table { border-collapse: collapse; width: 100%; font-size: .8rem; }
  th, td { padding: .25rem .5rem; border-bottom: var(--gh, 1px solid var(--border)); text-align: left; white-space: nowrap; }
  th { position: sticky; top: 0; background: var(--th-bg, var(--bg)); color: var(--th-fg, var(--fg)); font-weight: var(--th-fw, 600); font-size: var(--th-fs, inherit); }
  td { font-size: var(--tr-fs, inherit); }
  tbody tr { background: var(--tr-bg, transparent); color: var(--tr-fg, inherit); }
  .tablewrap.rh td:first-child { background: var(--rh-bg); color: var(--rh-fg, inherit); font-weight: 600; }
  tfoot td { position: sticky; bottom: 0; font-weight: 700; background: var(--tt-bg, var(--bg)); color: var(--tt-fg, inherit); border-top: 2px solid var(--tt-bg, var(--border)); }
  tbody tr:nth-child(even) { background: var(--tr-bg-alt, var(--tr-bg, transparent)); }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  th + th, td + td { border-left: var(--gv, none); }
  th { text-align: var(--th-ta, left); } th.num { text-align: var(--th-ta, right); }
  .text { padding: .5rem .6rem; font-size: .85rem; overflow: auto; }
  .static { border-style: dashed; opacity: .5; }
  .visual[hidden] { display: none; }
  .visual.btn { background: var(--bg0, transparent); border-radius: var(--rad, 0); box-shadow: var(--ol, none); }
  .visual.btn .shape-text { color: var(--fg, inherit); font-size: var(--fs, .8rem); font-family: var(--ff, inherit); font-weight: var(--fw, normal); font-style: var(--fi, normal); text-decoration: var(--td, none); justify-content: var(--jc, center); align-items: var(--ai, center); text-align: var(--ta, center); }
  .visual.btn:hover { background: var(--bg-h, var(--bg0, transparent)); box-shadow: var(--ol-h, var(--ol, none)); }
  .visual.btn:hover .shape-text { color: var(--fg-h, var(--fg, inherit)); }
  .visual.btn:active { background: var(--bg-p, var(--bg-h, var(--bg0, transparent))); box-shadow: var(--ol-p, var(--ol-h, var(--ol, none))); }
  .visual.btn:active .shape-text { color: var(--fg-p, var(--fg-h, var(--fg, inherit))); }
  .visual.btn.off, .visual.btn.off:hover { background: var(--bg-d, var(--bg0, transparent)); box-shadow: var(--ol-d, var(--ol, none)); cursor: default; }
  .visual.btn.off .shape-text { color: var(--fg-d, var(--fg, inherit)); }
  .info-icon { display: inline-flex; align-items: center; justify-content: center; width: 1.3rem; height: 1.3rem; margin: .2rem; border: 1.5px solid var(--accent, #666); border-radius: 50%; font: italic 700 .8rem serif; color: var(--accent, #666); cursor: help; }
  .clickable { cursor: pointer; }
  .clickable:hover { opacity: .8; }
  .error { color: #b00020; font-size: .75rem; padding: .5rem .6rem; }
  .loading { color: var(--muted); font-size: .75rem; padding: .5rem .6rem; }
  .visual.sl-box { overflow: visible; }
  .sl { --sl-fg: var(--fg); --sl-bg: var(--bg); --sl-fs: .85rem; color: var(--sl-fg); font-size: var(--sl-fs); }
  .sl-btn, .sl-text, .sl-range input { width: 100%; box-sizing: border-box; font: inherit; color: inherit; background: var(--sl-bg); border: 1px solid var(--border); border-radius: 2px; padding: .3rem .5rem; }
  .sl-btn { display: flex; justify-content: space-between; align-items: center; cursor: pointer; text-align: left; }
  .sl-btn:disabled { cursor: default; opacity: .8; }
  .sl-sep { color: var(--sl-sep, var(--sl-fg)); }
  .sl-range { display: flex; gap: .3rem; align-items: center; }
  .sl-range input { flex: 1 1 0; min-width: 0; }
  .sl-list { max-height: 100%; overflow: auto; background: var(--sl-bg); }
  .sl-item { display: flex; align-items: center; gap: .4rem; padding: .15rem .4rem; cursor: pointer; white-space: nowrap; }
  .sl-item:hover { background: rgba(127,127,127,.12); }
  .sl-parent { font-weight: 600; }
  .sl-panel { position: fixed; z-index: 2147483000; max-height: 18rem; display: flex; flex-direction: column; background: var(--bg); color: var(--fg); border: 1px solid var(--border); box-shadow: 0 4px 14px rgba(0,0,0,.18); font-size: .85rem; }
  .sl-panel .sl-list { overflow: auto; }
  .sl-search { margin: .3rem; padding: .25rem .4rem; font: inherit; }
  .sl-tiles { display: flex; flex-wrap: wrap; gap: .3rem; align-items: center; height: 100%; overflow: auto; }
  .sl-tile { font: inherit; color: inherit; background: var(--sl-bg); border: 1px solid var(--border); border-radius: 999px; padding: .2rem .7rem; cursor: pointer; }
  .sl-tile:disabled { cursor: default; opacity: .8; }
  .sl-tile.on { background: var(--accent); color: var(--accent-text, #fff); border-color: var(--accent); }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
  @media print { nav.tabs, .params { display: none; } .page[hidden] { display: block; page-break-after: always; } .page.navonly[hidden] { display: none; } }
</style>
</head>
<body>
<header>
  <h1>{{ spec.report }}</h1>
  <span class="meta">{% if mode == "snapshot" %}Data as of {{ generated_at }}{% if role %} · role {{ role }}{% endif %}{% else %}Live data{% endif %}</span>
</header>

{% set tab_pages = spec.pages|rejectattr('nav_only')|list %}
{% if tab_pages|length > 1 %}
<nav class="tabs" role="tablist">
  {% for p in tab_pages %}<button role="tab" data-page="{{ p.id }}" aria-selected="{{ 'true' if p.initial else 'false' }}">{{ p.name }}</button>{% endfor %}
</nav>
{% endif %}

{% set bar_params = spec.parameters.items()|rejectattr('1.widget')|list %}
{% if bar_params %}
<div class="params">
  {% for name, p in bar_params %}
  <label>{{ p.label }}
    {% if mode == "live" %}<input data-param="{{ name }}" value="{{ p.value if p.value is not none else '' }}">{% else %}<strong>{{ p.value if p.value is not none else '—' }}</strong>{% endif %}
  </label>
  {% endfor %}
</div>
{% endif %}

{% for p in spec.pages %}
<section class="page{{ ' navonly' if p.nav_only }}" id="{{ p.id }}" data-w="{{ p.width }}" data-hidden-groups='{{ p.hidden_groups|tojson }}' style="--ratio: {{ p.width }} / {{ p.height }}{% if p.background_image %}; background: {{ p.background_image }}{% if p.background %} {{ p.background }}{% endif %}{% elif p.background %}; background: {{ p.background }}{% endif %}" {% if not p.initial %}hidden{% endif %}>
  {% for v in p.visuals %}
  {# style: what the .pbix actually says about this visual's frame. Power BI's own
     default is no border and no fill, so a visual that says nothing gets neither —
     drawing a box around everything is what made every report look like a grid. #}
  <div class="visual{{ ' static' if v.kind == 'static' and not v.action and not v.style.background and not v.style.line_color and not v.style.border and not v.image and not v.texts.shape_text }}{{ ' clickable' if v.action }}{{ ' btn' if v.btn_css }}{{ ' off' if v.btn_off }}" id="v-{{ v.id }}" data-visual="{{ v.id }}" data-kind="{{ v.kind }}"{% if v.groups %} data-groups="{{ v.groups|join(' ') }}"{% endif %}{% if v.start_hidden %} hidden{% endif %}{% if v.action %}{% if v.action.type == "page" %} data-nav="{{ v.action.target }}"{% else %} data-set='{{ v.action.set|tojson }}'{% endif %} role="button" tabindex="0"{% endif %}
       style="left:{{ v.left }}%; top:{{ v.top }}%; width:{{ v.w }}%; height:{{ v.h }}%; z-index:{{ v.z }}
              {% if v.btn_css %}; {{ v.btn_css }}{% else %}; background: {{ v.style.background or 'transparent' }}{% endif %}
              ; border: {% if v.style.border %}{{ v.style.border_weight or 1 }}px solid {{ v.style.border_color or 'var(--border)' }}{% else %}none{% endif %}
              {% if v.style.round_edge %}; border-radius: {{ v.style.round_edge }}px{% elif v.style.border_radius %}; border-radius: {{ v.style.border_radius }}px{% elif v.style.shape_kind == 'oval' %}; border-radius: 50%{% endif %}
              {# a "line" shape's rotation is Power BI's way of drawing a *vertical* line, not a
                 rotated box: a long, thin box rotated in place around its own centre swings far
                 outside that box (confirmed against a real report — a 1280x23 header line
                 rotated 90 degrees covered unrelated text hundreds of pixels below it), so this
                 is applied to any other shape but not to a line — style.rotation is still
                 extracted either way, for whoever tackles drawing a rotated line correctly. #}
              {% if v.style.rotation and v.style.shape_kind != 'line' %}; transform: rotate({{ v.style.rotation }}deg){% endif %}">
    {% if v.title %}<div class="title"{% if v.title_css %} style="{{ v.title_css }}"{% endif %}>{{ v.title }}</div>{% endif %}
    {% if v.texts.subtitle %}<div class="subtitle">{{ v.texts.subtitle }}</div>{% endif %}
    <div class="body"></div>
  </div>
  {% endfor %}
</section>
{% endfor %}

<script id="spec" type="application/json">{{ spec_json|safe }}</script>
{% if mode == "snapshot" %}<script id="data" type="application/json">{{ data_json|safe }}</script>
<script id="slicer-data" type="application/json">{{ slicer_json|safe }}</script>
{% else %}<script>window.API_BASE = {{ api_base|tojson }};</script>{% endif %}

<script>
(function () {
  const spec = JSON.parse(document.getElementById('spec').textContent);
  const theme = spec.theme;
  const visualsById = {};
  spec.pages.forEach(p => p.visuals.forEach(v => { visualsById[v.id] = v; }));
  const charts = {};

  // ---------- slicers: one state object per parameter, shared by every widget bound to it ----------
  const paramState = {};
  Object.keys(spec.parameters).forEach(n => { paramState[n] = spec.parameters[n].value === undefined ? null : spec.parameters[n].value; });
  const slicerRefreshers = [];
  let reloadTimer = null;
  const changedParams = new Set();
  const slicerHost = {
    interactive: !!window.API_BASE,
    get: name => paramState[name],
    set(update) {
      Object.keys(update).forEach(n => { paramState[n] = update[n]; changedParams.add(n); });
      slicerRefreshers.forEach(fn => fn());
      clearTimeout(reloadTimer);
      reloadTimer = setTimeout(() => { const names = new Set(changedParams); changedParams.clear(); if (window.API_BASE) load(names); }, 250);
    },
    options(id) {
      if (!window.API_BASE) { const d = JSON.parse(document.getElementById('slicer-data').textContent); return Promise.resolve(d[id] || { skipped: true }); }
      return fetch(`${window.API_BASE}/reports/${encodeURIComponent(spec.report)}/slicers/${encodeURIComponent(id)}`)
        .then(r => r.ok ? r.json() : { error: `HTTP ${r.status}` });
    },
  };
  {{ slicer_js|safe }}

  // ---------- formatting ----------
  const fmt = (v, f) => {
    if (v === null || v === undefined) return '—';
    if (typeof v !== 'number') return String(v);
    if (f && f.includes('%')) return (v * 100).toLocaleString('en-US', { maximumFractionDigits: 1 }) + '%';
    if (f && /0\.00/.test(f)) return v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (Math.abs(v) >= 1e6) return (v / 1e6).toLocaleString('en-US', { maximumFractionDigits: 1 }) + ' M';
    if (Math.abs(v) >= 1e4) return (v / 1e3).toLocaleString('en-US', { maximumFractionDigits: 1 }) + ' k';
    return v.toLocaleString('en-US', { maximumFractionDigits: 2 });
  };
  // A card's number as the report formats it: display unit (1 none, 1000 K, 1000000 M, 1e9 bn, 1e12 T; 0/unset auto)
  // and decimals. Without either it falls back to fmt().
  const UNITS = { 1000: ' K', 1e6: ' M', 1e9: ' bn', 1e12: ' T' };
  const fmtCard = (v, x) => {
    const st = v.style || {};
    if (typeof x !== 'number' || (st.value_units === undefined && st.value_decimals === undefined) || (v.format.value || '').includes('%')) return fmt(x, v.format.value);
    let u = st.value_units, div = 1;
    if (!u) { const a = Math.abs(x); u = a >= 1e12 ? 1e12 : a >= 1e9 ? 1e9 : a >= 1e6 ? 1e6 : a >= 1e3 ? 1000 : 1; }
    if (u > 1) div = u;
    const d = Math.min(Math.max(st.value_decimals === undefined ? (div > 1 ? 1 : 0) : st.value_decimals, 0), 10);
    return (x / div).toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d }) + (UNITS[div] || '');
  };
  // Conditional formatting of a table's value columns (extract._cond_formats): a colour gradient, colour rules or an
  // icon. Applied by field position, so only when the well has as many fields as the SQL has columns.
  const hexRgb = h => [1, 3, 5].map(i => parseInt(h.slice(i, i + 2), 16));
  const rgbHex = c => '#' + c.map(x => Math.round(Math.max(0, Math.min(255, x))).toString(16).padStart(2, '0')).join('');
  const lum = h => { const [r, g, b] = hexRgb(h).map(x => { x /= 255; return x <= .03928 ? x / 12.92 : Math.pow((x + .055) / 1.055, 2.4); }); return .2126 * r + .7152 * g + .0722 * b; };
  const inkFor = bg => lum(bg) > .4 ? '#1F1F1F' : '#FFFFFF';
  const holds = (w, x) => w.and ? w.and.every(t => holds(t, x)) : w.or ? w.or.some(t => holds(t, x))
    : ({ '=': x === w.v, '>': x > w.v, '>=': x >= w.v, '<': x < w.v, '<=': x <= w.v })[w.op];
  const ICONS = { High: ['\u2714', '#2E7D32'], Low: ['\u2716', '#C62828'], Medium: ['\u25CF', '#F9A825'] };
  function condCell(rules, vals, x) {          // -> { bg, fg, icon } for the value x of one column
    const out = {};
    if (typeof x !== 'number') return out;
    for (const r of rules) {
      if (r.kind === 'gradient') {
        const lo = r.stops[0].value ?? Math.min(...vals), hi = r.stops[r.stops.length - 1].value ?? Math.max(...vals);
        const mid = r.stops.length === 3 ? (r.stops[1].value ?? (lo + hi) / 2) : null;
        const pts = [[lo, r.stops[0].color], ...(mid === null ? [] : [[mid, r.stops[1].color]]), [hi, r.stops[r.stops.length - 1].color]];
        let c = x <= pts[0][0] ? pts[0][1] : x >= pts[pts.length - 1][0] ? pts[pts.length - 1][1] : null;
        for (let i = 1; c === null && i < pts.length; i++) if (x <= pts[i][0]) {
          const t = (x - pts[i - 1][0]) / ((pts[i][0] - pts[i - 1][0]) || 1), a = hexRgb(pts[i - 1][1]), b2 = hexRgb(pts[i][1]);
          c = rgbHex(a.map((v0, k) => v0 + (b2[k] - v0) * t));
        }
        if (r.prop === 'back') { out.bg = c; out.fg = inkFor(c); } else out.fg = c;
      } else {
        const hit = r.rules.find(z => holds(z.when, x));
        if (!hit) continue;
        if (r.prop === 'icon') out.icon = hit.icon;
        else if (r.prop === 'back') { out.bg = hit.color; out.fg = inkFor(hit.color); } else out.fg = hit.color;
      }
    }
    return out;
  }
  const iconOf = name => { const k = Object.keys(ICONS).find(n => name.includes(n)); return k ? ICONS[k] : null; };
  // the grand-total row, computed by Teradata (yaml `sql_total`): blank where the measure is not additive
  const totalRow = (v, b, isNum) => (b.total && b.total.length === b.columns.length)
    ? '<tfoot><tr>' + b.total.map((x, i) => `<td class="${isNum[i] ? 'num' : ''}">${x === null || x === undefined ? '' : (typeof x === 'number' ? fmt(x, v.format[b.columns[i]]) : x)}</td>`).join('') + '</tr></tfoot>' : '';
  // Categories that are months ("June 2026", "Mar-25", "March") come back in whatever order the database likes; Power BI
  // shows them in calendar order (the model sorts the label by its date). Reordered only when the report names no
  // sort of its own and every category reads as a month, so a sort by value is never undone.
  const MONTHS = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'];
  const monthKey = c => {
    const m = /(?:^|[^a-z])(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*(?![a-z])/i.exec(String(c));
    if (!m) return null;
    const y = /(?:^|\D)(\d{4}|\d{2})(?!\d)/.exec(String(c).replace(m[0], ' '));
    const yr = y ? (y[1].length === 2 ? 2000 + +y[1] : +y[1]) : 0;
    return yr * 12 + MONTHS.indexOf(m[1].toLowerCase());
  };
  const inCalendarOrder = (v, cats) => {
    if (v.has_sort || cats.length < 2) return cats;
    const keys = cats.map(monthKey);
    return keys.every(k => k !== null) && new Set(keys).size === cats.length
      ? cats.map((c, i) => [c, keys[i]]).sort((a, b) => a[1] - b[1]).map(x => x[0]) : cats;
  };
  const col = (block, name) => block.columns.indexOf(name);
  const series = (block) => {
    const ci = col(block, 'category'), vi = col(block, 'value'), si = col(block, 'series');
    const cats = [], groups = new Map();
    block.rows.forEach(r => {
      if (r[vi] === null) return;
      const c = String(r[ci]); if (!cats.includes(c)) cats.push(c);
      const s = si >= 0 ? String(r[si]) : 'value';
      if (!groups.has(s)) groups.set(s, new Map());
      groups.get(s).set(c, r[vi]);
    });
    return { cats, groups };
  };
  const base = { color: theme.data_colors, textStyle: { fontFamily: theme.font_family, color: theme.foreground },
                 grid: { left: 8, right: 12, top: 28, bottom: 8, containLabel: true },
                 tooltip: { trigger: 'axis', valueFormatter: v => fmt(v) } };
  const axisStyle = { axisLine: { lineStyle: { color: theme.border } }, axisLabel: { color: theme.muted },
                      splitLine: { lineStyle: { color: theme.border } } };

  // ---------- renderers ----------
  const R = {
    card(el, v, b) {
      const vi = col(b, 'value'), li = col(b, 'label'); const r = b.rows[0] || [];
      el.innerHTML = `<div class="card"><div class="value"${v.value_css ? ` style="${v.value_css}"` : ''}>${fmtCard(v, r[vi])}</div>` +
        (li >= 0 && r[li] ? `<div class="label">${r[li]}</div>` : '') + `</div>`;
    },
    kpi(el, v, b) {
      const r = b.rows[0] || []; const vi = col(b, 'value'), ti = col(b, 'target');
      const delta = (ti >= 0 && r[ti]) ? (r[vi] - r[ti]) / r[ti] : null;
      el.innerHTML = `<div class="card kpi"><div class="value"${v.value_css ? ` style="${v.value_css}"` : ''}>${fmtCard(v, r[vi])}</div>` +
        (ti >= 0 ? `<div class="target">Target ${fmt(r[ti], v.format.value)}${delta !== null ? ' · ' + fmt(delta, '%') : ''}</div>` : '') + `</div>`;
    },
    multicard(el, v, b) {
      const li = col(b, 'label'), vi = col(b, 'value');
      el.innerHTML = '<div class="multicard">' + b.rows.map(r => `<div>${r[li]}</div><div class="v">${fmt(r[vi], v.format.value)}</div>`).join('') + '</div>';
    },
    table(el, v, b) {
      const isNum = b.columns.map((_, i) => b.rows.some(r => typeof r[i] === 'number'));
      const applyCond = {}, colVals = {};
      const ca = i => (v.col_align && v.n_fields === b.columns.length && v.col_align[i]) ? ` style="text-align:${v.col_align[i]}"` : '';
      if (v.cond_formats && v.cond_formats.length && v.n_fields === b.columns.length) v.cond_formats.forEach(c => { (applyCond[c.col] = applyCond[c.col] || []).push(c); colVals[c.col] = b.rows.map(r => r[c.col]).filter(n => typeof n === 'number'); });
      const st = v.style || {};
      const vars = [
        st.table_header_bg && `--th-bg:${st.table_header_bg}`, st.table_header_fg && `--th-fg:${st.table_header_fg}`,
        st.table_row_bg && `--tr-bg:${st.table_row_bg}`, st.table_row_bg_alt && `--tr-bg-alt:${st.table_row_bg_alt}`,
        st.table_row_fg && `--tr-fg:${st.table_row_fg}`,
        st.table_header_size && `--th-fs:calc(${(st.table_header_size * 4 / 3).toFixed(1)}px * var(--scale, 1))`, st.table_row_size && `--tr-fs:calc(${(st.table_row_size * 4 / 3).toFixed(1)}px * var(--scale, 1))`,
        st.table_header_align && `--th-ta:${st.table_header_align}`, st.table_header_bold !== undefined && `--th-fw:${st.table_header_bold ? 700 : 400}`,
        st.table_grid_h === false ? '--gh:none' : (st.table_grid_h_color || st.table_grid_h_weight) && `--gh:${st.table_grid_h_weight || 1}px solid ${st.table_grid_h_color || 'var(--border)'}`,
        st.table_grid_v && `--gv:${st.table_grid_v_weight || 1}px solid ${st.table_grid_v_color || '#E1E1E1'}`,
        st.table_total_bg && `--tt-bg:${st.table_total_bg}`, st.table_total_fg && `--tt-fg:${st.table_total_fg}`,
        st.table_rowhdr_bg && `--rh-bg:${st.table_rowhdr_bg}`, st.table_rowhdr_fg && `--rh-fg:${st.table_rowhdr_fg}`,
      ].filter(Boolean).join(';');
      el.innerHTML = `<div class="tablewrap${v.kind === 'matrix' && st.table_rowhdr_bg ? ' rh' : ''}"${vars ? ` style="${vars}"` : ''}><table><thead><tr>` +
        b.columns.map((c, i) => `<th class="${isNum[i] ? 'num' : ''}"${ca(i)}>${v.headers?.[c] || (v.header_names && v.header_names.length === b.columns.length ? v.header_names[i] : c)}</th>`).join('') + '</tr></thead><tbody>' +
        b.rows.map(r => '<tr>' + r.map((x, i) => {
          const cf = applyCond[i] ? condCell(applyCond[i], colVals[i], x) : {};
          const ic = cf.icon ? iconOf(cf.icon) : null;
          const style = [v.col_align && v.n_fields === b.columns.length && v.col_align[i] && `text-align:${v.col_align[i]}`, cf.bg && `background:${cf.bg}`, cf.fg && `color:${ic ? ic[1] : cf.fg}`].filter(Boolean).join(';');
          const text = cf.icon ? (ic ? ic[0] : '') : isNum[i] ? fmt(x, v.format[b.columns[i]]) : (x ?? '');
          return `<td class="${isNum[i] ? 'num' : ''}"${style ? ` style="${style}"` : ''}${cf.icon ? ' data-icon="1"' : ''}>${text}</td>`;
        }).join('') + '</tr>').join('') +
        '</tbody>' + totalRow(v, b, isNum) + '</table></div>';
    },
    matrix(el, v, b) { R.table(el, v, b); },
    text(el, v) { el.innerHTML = `<div class="text">${v.text || ''}</div>`; },
    slicer(el, v) { slicerRefreshers.push(slicerWidget(el, v, slicerHost)); },
    tooltip(el, v) {          // an info icon: the definition is its (native) tooltip
      const i = document.createElement('span');
      i.className = 'info-icon'; i.textContent = 'i'; i.tabIndex = 0; i.setAttribute('role', 'img');
      if (v.tooltip) { i.title = v.tooltip; i.setAttribute('aria-label', v.tooltip); }
      el.replaceChildren(i);
    },
    static(el, v) {
      // An `image` visual has its picture embedded as a data: URI; a shape or button
      // instead carries a label (extract.py's visual_text). Either way the point is not
      // to leave the box blank, which is what happened to both until now.
      if (v.style && v.style.line_color) {
        const w = v.style.line_weight || 2;
        el.innerHTML = `<div style="position:absolute;left:0;right:0;top:50%;height:${w}px;margin-top:${-w / 2}px;background:${v.style.line_color}"></div>`;
      } else if (v.image) {
        el.innerHTML = `<img src="${v.image}" alt="" style="width:100%;height:100%;object-fit:contain;">`;
      } else if (v.texts && v.texts.shape_text) {
        el.innerHTML = '<div class="shape-text"></div>';
        el.firstChild.textContent = v.texts.shape_text;
      } else {
        el.innerHTML = '';
      }
    },
    bar(el, v, b) { chart(el, v, cartesian(v, b, 'bar', true)); },
    column(el, v, b) { chart(el, v, cartesian(v, b, 'bar', false)); },
    line(el, v, b) { chart(el, v, cartesian(v, b, 'line', false, v.area)); },
    combo(el, v, b) { chart(el, v, cartesian(v, b, 'combo', false)); },
    pie(el, v, b) {
      const ci = col(b, 'category'), vi = col(b, 'value');
      chart(el, v, { ...base, tooltip: { trigger: 'item', valueFormatter: x => fmt(x) },
        series: [{ type: 'pie', radius: v.inner_radius ? ['45%', '75%'] : '75%',
                   data: b.rows.filter(r => r[vi] !== null).map(r => ({ name: String(r[ci]), value: r[vi],
                   ...(((v.style || {}).value_colors || {})[String(r[ci])] ? { itemStyle: { color: v.style.value_colors[String(r[ci])] } } : {}) })),
                   label: { color: theme.foreground, fontSize: 11 } }] });
    },
    gauge(el, v, b) {
      const r = b.rows[0] || []; const g = n => { const i = col(b, n); return i >= 0 ? r[i] : null; };
      chart(el, v, { ...base, series: [{ type: 'gauge', min: g('min') ?? 0, max: g('max') ?? (g('target') ?? g('value')) * 1.2,
        progress: { show: true }, detail: { formatter: x => fmt(x, v.format.value), color: theme.foreground },
        axisLabel: { show: false }, data: [{ value: g('value') }] }] });
    },
  };
  function cartesian(v, b, type, horizontal, area) {
    const { cats: seen, groups } = series(b);
    const cats = inCalendarOrder(v, seen);
    // 100% stacked: every category's series are rescaled to share 100 (ECharts has no such mode)
    const totals = v.percent ? cats.map(c => [...groups.values()].reduce((t, m) => t + (m.get(c) || 0), 0)) : null;
    const val = (m, c, i) => { const x = m.get(c) ?? null; return totals && x !== null ? (totals[i] ? 100 * x / totals[i] : 0) : x; };
    const cs = v.style || {};
    // the report's own colours: per value of the series/category field (`value_colors`), per measure (`series_colors`,
    // keyed by the field in the Y well, in well order = series order), else one fill for every bar (`point_color`)
    const vc = cs.value_colors || {}, sc = cs.series_colors || {}, yr = v.y_refs || [];
    // a measure series is labelled by the drafted SQL ("col" or "Table: col"); the report shows its own caption, in well order
    const yf = v.y_fields || [];
    const fieldOf = name => yf.findIndex(f => name === f.prop || name === f.entity + ': ' + f.prop);
    const order = [...groups.keys()];
    if (yf.length && order.every(n => fieldOf(n) >= 0)) order.sort((a, b) => fieldOf(a) - fieldOf(b));
    const shown = n => { const k = fieldOf(n); return k >= 0 ? yf[k].name : n; };
    const refOf = (i, n) => { const k = fieldOf(n); return k >= 0 ? yf[k].ref : yr[i]; };
    const colorOf = (i, name) => vc[name] || (refOf(i, name) && sc[refOf(i, name)]) || (cs.point_color && (groups.size === 1 || Object.keys(sc).length) ? cs.point_color : null);
    const labelPos = horizontal ? { OutsideEnd: 'right', InsideEnd: 'insideRight', InsideCenter: 'inside', InsideBase: 'insideLeft' }
                                : { OutsideEnd: 'top', InsideEnd: 'insideTop', InsideCenter: 'inside', InsideBase: 'insideBottom' };
    const insideLabel = v.stacked || /^inside/.test(labelPos[cs.labels_pos] || '');
    const labelFor = (i, name) => { const bar = colorOf(i, name); return cs.labels_color || (insideLabel && bar ? inkFor(bar) : insideLabel ? '#FFFFFF' : theme.muted); };
    const label = cs.labels ? { show: true, position: v.stacked ? 'inside' : (labelPos[cs.labels_pos] || labelPos.OutsideEnd),
      color: undefined, fontWeight: cs.labels_bold ? 'bold' : 'normal',
      fontSize: cs.labels_size ? Math.round(cs.labels_size * 4 / 3) : 11,
      formatter: p => v.percent ? Math.round(p.value) + '%' : fmtCard({ style: { value_units: cs.labels_units, value_decimals: cs.labels_precision }, format: v.format }, p.value) } : undefined;
    const ser = order.map(n => [n, groups.get(n)]).map(([name, m], i) => ({
      name: shown(name), type: type === 'combo' ? (v.axis && v.axis[name] === 'line' ? 'line' : 'bar') : type,
      // a colour the report gave to one value of the category field recolours that bar (single series only)
      data: cats.map((c, k) => groups.size === 1 && vc[c] ? { value: val(m, c, k), itemStyle: { color: vc[c] } } : val(m, c, k)), stack: v.stacked ? 'total' : undefined,
      areaStyle: area ? (colorOf(i, name) ? { color: colorOf(i, name) } : {}) : undefined, smooth: false, label: label && { ...label, color: labelFor(i, name) },
      ...(colorOf(i, name) ? { itemStyle: { color: colorOf(i, name) }, lineStyle: { color: colorOf(i, name) } } : {}),
      ...(type === 'line' ? { symbol: 'circle', symbolSize: 5 } : {}),
    }));
    // Axis and legend titles as the report labels them (extract.py's visual_text).
    // Only set when the report actually names one — an axis titled by default in
    // Power BI carries no text, and inventing one would read as our own caption.
    const t = v.texts || {};
    const axisTitle = name => name ? { name, nameLocation: 'middle', nameGap: 26,
                                       nameTextStyle: { color: theme.muted, fontSize: 10 } } : {};
    const catAxis = { type: 'category', data: cats, ...axisStyle, ...axisTitle(t.axis_x), show: horizontal ? cs.y_axis_show !== false && cs.x_axis_show !== false : cs.x_axis_show !== false };
    const valAxis = { type: 'value', ...(v.percent ? { min: 0, max: 100 } : {}), ...axisStyle, show: cs.y_axis_show !== false,
                      splitLine: { show: cs.gridlines !== false, lineStyle: { color: theme.border, type: 'dotted' } }, axisLabel: { color: theme.muted, formatter: x => v.percent ? x + '%' : fmt(x, v.format.value) },
                      ...axisTitle(t.axis_y) };
    const lp = cs.legend_pos || 'Top';
    const legend = groups.size > 1 && cs.legend_show !== false
      ? { icon: 'circle', itemWidth: 9, itemHeight: 9, textStyle: { color: theme.muted, fontSize: 11 }, ...(t.legend ? { name: t.legend } : {}),
          ...(/Bottom/.test(lp) ? { bottom: 0 } : /Left/.test(lp) ? { left: 0, top: 'middle', orient: 'vertical' }
             : /Right/.test(lp) ? { right: 0, top: 'middle', orient: 'vertical' } : { top: 0, left: /Center/.test(lp) ? 'center' : 0 }) }
      : undefined;
    // containLabel reserves room for tick labels but not for an axis *name*, so a title
    // on the bottom/left axis gets clipped at the edge unless the grid is opened up.
    const grid = { ...base.grid,
                   bottom: base.grid.bottom + (t.axis_x || t.axis_y ? 20 : 0),
                   left: base.grid.left + (t.axis_x || t.axis_y ? 16 : 0) };
    return { ...base, grid, legend,
             xAxis: horizontal ? valAxis : catAxis, yAxis: horizontal ? { ...catAxis, inverse: true } : valAxis, series: ser };
  }
  function chart(el, v, option) {
    el.innerHTML = '<div class="chart"></div>';
    const c = echarts.init(el.firstChild, null, { renderer: 'canvas' });
    // The tooltip lives in <body>, above every visual: inside the chart's own box it is clipped by the visual
    // (`overflow: hidden`) and loses to any visual stacked higher, which is what hid it behind other charts.
    option.tooltip = { ...(option.tooltip || {}), appendToBody: true, confine: false, extraCssText: 'z-index:2147483600;' };
    c.setOption(option); charts[v.id] = c;
  }

  // Text that does not fit its box shrinks (down to 9px) before it is cut with "…": Power BI's font sizes are
  // absolute while the page here scales with the window, so a title or a big number that fit at design size
  // would otherwise be truncated on a narrower screen.
  function fitText(vis) {
    scalePage(vis.closest('.page'));
    vis.querySelectorAll('.title, .subtitle, .card .value, .card .label, .kpi .target').forEach(n => {
      if (n.dataset.fs === undefined) n.dataset.fs = n.style.fontSize || '';
      n.style.fontSize = n.dataset.fs; n.classList.remove('wrap');
      const over = () => n.scrollWidth > n.clientWidth + 1;
      let px = parseFloat(getComputedStyle(n).fontSize);
      const title = n.classList.contains('title');
      for (let i = 0; i < 60 && px > (title ? 11 : 9) && over(); i++) { px -= 1; n.style.fontSize = px + 'px'; }
      if (title && over()) n.classList.add('wrap');          // still too long: two lines, then "…"
    });
  }
  // Power BI sizes are px at the page's design width: --scale is how much the page is shrunk or grown here
  const scalePage = pg => { if (pg && pg.clientWidth) pg.style.setProperty('--scale', (pg.clientWidth / (parseFloat(pg.dataset.w) || pg.clientWidth)).toFixed(4)); };
  const fitAll = () => { document.querySelectorAll('.visual').forEach(fitText); };

  // ---------- data ----------
  function paint(id, block) {
    const v = visualsById[id]; const el = document.querySelector(`#v-${CSS.escape(id)} .body`);
    if (!el) return;
    if (block.error) { el.innerHTML = `<div class="error">${block.error}</div>`; return; }
    // Check "no sql written yet" before "no renderer for this kind": an unimplemented
    // visual type (kind "unsupported"/"custom") is expected and still TODO right out of
    // scaffold — it should read as "not started" here, not look like a crash.
    if (block.skipped && !['text', 'static', 'slicer', 'tooltip'].includes(v.kind)) { el.innerHTML = '<div class="loading">No query defined</div>'; return; }
    const fn = R[v.kind];
    if (!fn) {
      el.innerHTML = `<div class="loading">Visual type "${v.kind}" isn't supported yet — pick a `
        + `different kind in the metrics yaml, or see out/summary.md.</div>`;
      return;
    }
    try { fn(el, v, block); } catch (e) { el.innerHTML = `<div class="error">${e.message}</div>`; }
    fitText(el.closest('.visual'));
  }
  function currentParams(names) {
    const q = new URLSearchParams();
    document.querySelectorAll('[data-param]').forEach(i => { if (i.value !== '') paramState[i.dataset.param] = spec.parameters[i.dataset.param].multi ? i.value.split(',').map(x => x.trim()).filter(Boolean) : i.value; });
    (names || Object.keys(paramState)).forEach(n => {
      const val = paramState[n];
      if (Array.isArray(val)) val.forEach(x => q.append(n, x));
      else if (val !== null && val !== undefined && val !== '') q.set(n, val);
    });
    return q.toString();
  }
  let slicersPainted = false;
  function paintSlicers() {           // widgets are drawn once: they hold their own state
    if (slicersPainted) return; slicersPainted = true;
    Object.values(visualsById).filter(v => v.kind === 'slicer').forEach(v => paint(v.id, { columns: [], rows: [], skipped: true }));
  }
  // live mode fetches a page's visuals when the page is first shown, not all pages up front
  const pageOfVisual = {};
  spec.pages.forEach(p => p.visuals.forEach(v => { pageOfVisual[v.id] = p.id; }));
  const loadedPages = new Set();
  async function load(changed, onlyPage) {   // `changed`: parameter names that moved, so only visuals using them reload
    paintSlicers();
    if (!onlyPage && spec.pages.length) { const first = spec.pages.find(p => p.initial) || spec.pages[0]; loadedPages.add(first.id); }
    const dataIds = Object.keys(visualsById).filter(id => visualsById[id].kind !== 'slicer'
      && (!window.API_BASE || (onlyPage ? pageOfVisual[id] === onlyPage : loadedPages.has(pageOfVisual[id])))
      && (!changed || (visualsById[id].params || []).some(n => changed.has(n))));
    if (!window.API_BASE) {
      const data = JSON.parse(document.getElementById('data').textContent);
      dataIds.forEach(id => paint(id, data[id] || { columns: [], rows: [], skipped: true }));
      return;
    }
    await Promise.all(dataIds.map(async id => {
      const qs = currentParams(visualsById[id].params);
      const el = document.querySelector(`#v-${CSS.escape(id)} .body`); if (el) el.innerHTML = '<div class="loading">Loading…</div>';
      try {
        // No `credentials: 'include'`: the identity comes from a header the reverse
        // proxy injects (see serve.py), not a browser cookie. Sending credentials here
        // forces the browser to require a non-wildcard Access-Control-Allow-Origin —
        // serve.py's default CORS_ORIGINS is "*", so this would make every fetch fail
        // with "Failed to fetch" even when serve.py is reachable and working. A
        // deployment that really does forward an SSO session cookie through the proxy
        // needs to set CORS_ORIGINS to that exact origin (not "*") and add this back.
        const r = await fetch(`${window.API_BASE}/reports/${encodeURIComponent(spec.report)}/visuals/${encodeURIComponent(id)}?${qs}`);
        paint(id, r.ok ? await r.json() : { error: `HTTP ${r.status}` });
      } catch (e) { paint(id, { error: e.message }); }
    }));
  }
  document.querySelectorAll('[data-param]').forEach(i => i.addEventListener('change', () => load()));
  function showPage(id) {
    document.querySelectorAll('nav.tabs button').forEach(x => x.setAttribute('aria-selected', x.dataset.page === id));
    document.querySelectorAll('.page').forEach(p => { p.hidden = p.id !== id; });
    Object.values(charts).forEach(c => c.resize());
    fitAll();
    if (window.API_BASE && !loadedPages.has(id)) { loadedPages.add(id); load(null, id); }
  }
  document.querySelectorAll('nav.tabs button').forEach(b => b.addEventListener('click', () => showPage(b.dataset.page)));
  document.querySelectorAll('[data-nav]').forEach(b => {
    b.addEventListener('click', () => showPage(b.dataset.nav));
    b.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); showPage(b.dataset.nav); } });
  });
  // Bookmark buttons: each page keeps the set of hidden groups; a visual is shown unless one
  // of its ancestor groups is in that set (ADR-005).
  const hiddenGroups = new Map();
  document.querySelectorAll('.page').forEach(pg => hiddenGroups.set(pg.id, new Set(JSON.parse(pg.dataset.hiddenGroups || '[]'))));
  function applyGroups(page) {
    const hs = hiddenGroups.get(page.id);
    page.querySelectorAll('[data-groups]').forEach(el => { el.hidden = el.dataset.groups.split(' ').some(g => hs.has(g)); });
    Object.values(charts).forEach(c => c.resize());
  }
  document.querySelectorAll('[data-set]').forEach(b => {
    const activate = () => {
      const page = b.closest('.page'), hs = hiddenGroups.get(page.id);
      Object.entries(JSON.parse(b.dataset.set)).forEach(([g, hidden]) => hidden ? hs.add(g) : hs.delete(g));
      applyGroups(page);
    };
    b.addEventListener('click', activate);
    b.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(); } });
  });
  window.addEventListener('resize', () => { Object.values(charts).forEach(c => c.resize()); fitAll(); });
  load();
})();
</script>
</body>
</html>
