# Copy to .env. Never commit it to the repository.
TERADATA_HOST=td.empresa.com
TERADATA_USER=svc_pbix2html
TERADATA_PASSWORD=
TERADATA_LOGMECH=TD2          # TD2 | LDAP | KRB5 | BROWSER — many corporate Teradata
                               # setups require LDAP (TD2 fails with error 8017)
TERADATA_DATABASE=
CACHE_TTL_SECONDS=3600
ECHARTS_CDN=https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js
API_BASE=http://localhost:8000    # live mode: the service's public URL
# CORS_ORIGINS=https://portal.empresa.com   # live mode, serve.py: leave unset for the
                               # open "*" default (no credentials). Only set this if a
                               # reverse proxy in front of serve.py forwards an SSO
                               # session cookie and you need credentialed CORS — it
                               # must be the exact origin the report is served from,
                               # never "*" (browsers reject wildcard + credentials).
# AUTH_HEADER=X-Authenticated-User   # live mode, serve.py: the header a reverse proxy
                               # injects after SSO — never trust a value from the
                               # browser/URL directly. Default shown; only change it if
                               # your reverse proxy uses a different header name.
# REQUIRE_AUTH=true             # live mode, serve.py: with no reverse proxy in front of
                               # serve.py (e.g. testing on your own machine), every
                               # visual request has no AUTH_HEADER and gets HTTP 401 —
                               # that's expected, it's the whole point of this check.
                               # Set REQUIRE_AUTH=false ONLY for local preview/testing
                               # without SSO; never in a real deployment, since that's
                               # what ties each query to a real person for Teradata's
                               # row-level security (proxy user) to apply correctly.

# --mode hah only (HTML App Host / teradata-report skill delivery, see ADR-004).
# Not needed for snapshot/live.
HAH_BASE_DEV=https://transcend-k8s-dev.td.teradata.com/dev-html-app-host
HAH_BASE_UAT=https://transcend-k8s-dev.td.teradata.com/html-app-host
HAH_BASE_PRD=https://transcend-k8s.td.teradata.com/html-app-host
